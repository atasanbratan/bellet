# Server
PORT=3000
NODE_ENV=development

# Database (matches docker-compose)
DATABASE_URL="postgresql://bellet:bellet@localhost:5432/bellet?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Reverse-SMS gateway (Android app auth) — CRITICAL, keep secret in prod
GATEWAY_SECRET=change-me-gateway-secret
# Fallback shown to clients only if no gateway app has reported in recently.
OUR_SMS_NUMBER="+993 6X XXXXXX"
# A gateway is considered offline after this many seconds without a heartbeat.
GATEWAY_ONLINE_TTL_SEC=1200
PHONE_VERIFICATION_TTL_MIN=10

# MinIO / S3 storage (matches docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bellet
S3_USE_PATH_STYLE=true
